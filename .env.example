# Copy to .env.local (gitignored). Only LINEAR_API_KEY is required.

# Personal API key from Linear > Settings > Security & access > API keys.
# A read-only key is enough unless you enable mutations below.
LINEAR_API_KEY=

# Let `mutation` operations through and expose schema.mutations. Subscriptions are always refused.
# LINEAR_MCP_ALLOW_MUTATIONS=true

# Give sandboxed code files.read() / files.write() for UTF-8 text files under the
# server's working directory and the Claude Code scratchpad. .env* files are always
# refused; write never overwrites and never creates directories.
# LINEAR_MCP_FS_READ=true
# LINEAR_MCP_FS_WRITE=true

# Lift the directory limit. Each needs its base flag above or it does nothing.
# LINEAR_MCP_FS_ALLOW_READ_OUTSIDE_CWD=true
# LINEAR_MCP_FS_ALLOW_WRITE_OUTSIDE_CWD=true

# Return whole tool results instead of cutting them at about 6,000 tokens.
# LINEAR_MCP_TRUNCATE=false

# Wall-clock budget per sandboxed call, in milliseconds.
# LINEAR_MCP_TIMEOUT_MS=30000

# LINEAR_API_URL=https://api.linear.app/graphql
